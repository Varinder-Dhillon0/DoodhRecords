    "@react-navigation/native": "^7.4.1",
    "@react-navigation/stack": "^7.11.2",
    "expo": "~57.0.0",
    "expo-application": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.3",
