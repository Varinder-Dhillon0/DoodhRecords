{
  "expo": {
    "name": "Doodh Records",
    "slug": "doodh-records",
    "version": "1.0.16",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.doodhrecords.app",
      "versionCode": 12,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing"
    ],
    "ios": {
      "bundleIdentifier": "com.doodhrecords.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "scheme": "doodhrecords",
    "extra": {
      "eas": {
        "projectId": "a7f6a1d1-7ff4-4d51-b72e-9c221a32d275"
      },
      "google": {
        "webClientId": "584039371276-abd735jd3fqh6u0gfpgn281ka4drg7i4.apps.googleusercontent.com"
      }
    }
  }
}
