{
  "expo": {
    "name": "Doodh Records",
    "slug": "doodh-records",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.doodhrecords.app",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sharing"
    ],
    "ios": {
      "bundleIdentifier": "com.doodhrecords.app"
    }
  }
}
